{
  "name": "@marinedotsh/better-auth-referral",
  "version": "0.3.0",
  "description": "Add referral codes and track referrals with Better Auth.",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "better-auth-referral",
    "better-auth-referrals",
    "auth",
    "referral",
    "referrals"
  ],
  "homepage": "https://github.com/marinedotsh/better-auth-referral#readme",
  "bugs": {
    "url": "https://github.com/marinedotsh/better-auth-referral/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinedotsh/better-auth-referral.git"
  },
  "license": "MIT",
  "author": {
    "name": "Shivam Gupta",
    "url": "https://github.com/shivamrun"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm build",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "lint": "biome check",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm run publish:check",
    "publish:check": "pnpm run check && tsdown --publint --attw && pnpm pack --dry-run",
    "release": "pnpm run publish:check && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "version": "changeset version"
  },
  "dependencies": {
    "nanoid": "^5.1.16"
  },
  "peerDependencies": {
    "better-auth": "^1.6.23",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "^2.31.0",
    "better-auth": "^1.6.23",
    "publint": "^0.3.21",
    "tsdown": "^0.22.5",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.1.2"
}
