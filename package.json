    "@sinclair/typebox": "^0.34.52",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "openapi-types": "^12.1.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
