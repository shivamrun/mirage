# Copy this file to .env.self-host. Never commit the populated file.
# Values used in URLs must be URL-encoded. Generate secrets with, for example:
#   openssl rand -base64 48

# Container database. DATABASE_URL must use the same database, user, and
# password, and must use the Compose service hostname `db`.
POSTGRES_DB=mirage
POSTGRES_USER=mirage
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://mirage:replace-with-a-long-url-safe-password@db:5432/mirage
DB_POOL_MAX=10

# Public URL at which the reverse proxy serves Mirage (no trailing slash).
# These NEXT_PUBLIC values are baked into the image at build time.
NEXT_PUBLIC_BASE_URL=https://mirage.example.com
BETTER_AUTH_URL=https://mirage.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Turnstile is required by public forms and authentication.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Stripe billing is currently required by application environment validation.
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Production email delivery (Resend).
RESEND_API_KEY=re_replace-me
EMAIL_FROM=Mirage <noreply@example.com>
# EMAIL_REPLY_TO=support@example.com

# Optional Google OAuth. Set both or leave both unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional S3-compatible uploads. Set the complete group or leave it unset.
# AWS_UPLOAD_ACCESS_KEY_ID=
# AWS_UPLOAD_SECRET_ACCESS_KEY=
# AWS_UPLOAD_SESSION_TOKEN=
# AWS_UPLOAD_BUCKET=
# AWS_UPLOAD_REGION=
# NEXT_PUBLIC_UPLOAD_BASE_URL=https://uploads.example.com

# Optional Umami analytics. NEXT_PUBLIC values require an image rebuild.
# NEXT_PUBLIC_UMAMI_ENABLED=true
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_DOMAINS=mirage.example.com
# UMAMI_HOST_URL=https://analytics.example.com

# Set this only when a trusted reverse proxy overwrites this header.
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Prevent key collisions if the Redis instances are shared in the future.
REDIS_KEY_PREFIX=mirage:production

# Keep the Redis data ceiling below its container limit to leave room for
# Redis process overhead.
REDIS_MAXMEMORY=256mb
REDIS_MEMORY_LIMIT=384m

# Bind to 127.0.0.1 when a reverse proxy runs on the Docker host.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
