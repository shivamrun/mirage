FROM node:24-alpine

RUN corepack enable
WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml source.config.mjs ./
COPY --chown=node:node packages/better-auth-referral/package.json packages/better-auth-referral/package.json
COPY --chown=node:node packages/upload-sdk/package.json packages/upload-sdk/package.json
COPY --chown=node:node content ./content
RUN pnpm install --prod --frozen-lockfile

COPY --chown=node:node . .

CMD ["pnpm", "jobs:worker"]
